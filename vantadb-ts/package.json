{
  "name": "vantadb",
  "version": "0.5.0",
  "description": "VantaDB TypeScript SDK — WASM-powered embedded vector & graph memory for JS runtimes (Node, Bun, Deno, browser)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/vantadb.js",
  "types": "dist/vantadb.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vantadb.d.ts",
      "import": "./dist/vantadb.js",
      "require": "./dist/vantadb.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "coverage": "npm run build && c8 --all --src ./src --reporter text --reporter json --reporter json-summary node test-runner.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ness-e/Vantadb.git"
  },
  "homepage": "https://vantadb.dev",
  "bugs": "https://github.com/ness-e/Vantadb/issues",
  "keywords": [
    "vector-database",
    "memory",
    "rag",
    "embeddings",
    "graph",
    "wasm",
    "ai",
    "semantic-search"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "vantadb-wasm": "file:../vantadb-wasm/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "eslint": "^10.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vantadb-node": "file:../vantadb-node",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}
