# ── Build artifacts ──
target/

# ── Cargo registry/cache (may contain credentials) ──
.cargo/

# ── Git ──
.git/
.gitignore

# ── Docker ──
Dockerfile
docker-compose*.yml
.dockerignore

# ── Node / Web ──
node_modules/
web/

# ── IDE / OS ──
.vanta*/
.idea/
.vscode/
*.swp
*.swo
*~

# ── Secrets (never ship) ──
.env
.env.*
*.pem
*.key
*.cert

# ── Logs ──
*.log

# ── Docs (not needed for build) ──
*.md
docs/
archive/

# ── Tests, fuzz, benches ──
# NOTE (SRV-07): tests/ and benches/ are intentionally NOT ignored — Cargo.toml
# declares explicit [[test]]/[[bench]] targets and cargo validates their paths
# at manifest-load time, so excluding them breaks `cargo build` inside the image.
fuzz/

#  Data (benchmark datasets, not needed to compile) 
data/

# ── Examples ──
examples/

# ── Python ──
__pycache__/
*.pyc

# ── CI ──
.github/
