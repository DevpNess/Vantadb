#!/bin/sh
# VantaDB pre-push hook (SIPP barrier, smart)
# Blocks the push when Rust (.rs) files changed and verification fails.
# Skips cargo entirely when the pushed commits change no .rs files
# (CI-only / docs-only / config-only pushes must not pay the full verify).
#
# Contract:
#   - No .rs changes in pushed range  -> print skip message, allow push (exit 0)
#   - .rs changes -> run dev-tools/verify_changed.ps1 (fmt+check+clippy, ~30s)
#   - verify fails -> BLOCK (exit non-zero)
#   - pwsh missing + .rs changes -> BLOCK with clear message

set -e

# --- Pre-push stdin: one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
RS_CHANGED=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue            # branch deletion: nothing to verify
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # First push of a new branch: diff against origin tip (or repo root as fallback)
        base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)
        if [ -z "$base" ]; then
            base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
        fi
    else
        base=$remote_sha
    fi

    if git diff --name-only "$base..$local_sha" 2>/dev/null | grep -q '\.rs$'; then
        RS_CHANGED=1
    fi
done

if [ "$RS_CHANGED" -eq 0 ]; then
    echo "pre-push: no .rs changes in pushed commits, skipping cargo. Push allowed."
    exit 0
fi

# --- Rust changed: run the quick verification barrier ---
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VERIFY_SCRIPT="$REPO_ROOT/dev-tools/verify_changed.ps1"

if [ ! -f "$VERIFY_SCRIPT" ]; then
    echo "pre-push: verify script not found at $VERIFY_SCRIPT. Push BLOCKED."
    exit 1
fi

echo "pre-push: .rs changes detected — running verification barrier..."
echo "pre-push: fmt -> check -> clippy (dev-tools/verify_changed.ps1)"

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$VERIFY_SCRIPT"
    STATUS=$?
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$VERIFY_SCRIPT"
    STATUS=$?
else
    echo "pre-push: ERROR — no PowerShell found (install pwsh 7+) but .rs files changed. Push BLOCKED."
    exit 1
fi

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "pre-push: Verification FAILED (exit code: $STATUS). Push BLOCKED."
    echo "pre-push: Fix the failures above, then retry the push."
    exit $STATUS
fi

echo "pre-push: barrier passed. Push allowed."
exit 0