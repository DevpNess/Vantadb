{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "title": "VantaDB Operations",
    "tags": ["vanta", "operations"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "panels": [
      {
        "title": "Process Memory",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes"
          }
        },
        "targets": [
          {
            "expr": "vanta_process_rss_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "RSS {{instance}}"
          },
          {
            "expr": "vanta_process_virtual_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Virtual {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "title": "HNSW Index",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes"
          }
        },
        "targets": [
          {
            "expr": "vanta_hnsw_logical_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Logical {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
      },
      {
        "title": "Query Latency P50/P95/P99",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(vanta_query_latency_ms_bucket{job=~\"vantadb.*\"}[5m]))",
            "legendFormat": "P50 {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(vanta_query_latency_ms_bucket{job=~\"vantadb.*\"}[5m]))",
            "legendFormat": "P95 {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, rate(vanta_query_latency_ms_bucket{job=~\"vantadb.*\"}[5m]))",
            "legendFormat": "P99 {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "title": "HTTP Requests / sec",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "rate(vanta_http_requests_total{job=~\"vantadb.*\"}[1m])",
            "legendFormat": "{{method}} {{route}} {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "title": "MMAP Resident Memory",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes"
          }
        },
        "targets": [
          {
            "expr": "vanta_mmap_resident_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "MMAP Resident {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
      },
      {
        "title": "Volatile Page Cache",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "vanta_volatile_cache_entries{job=~\"vantadb.*\"}",
            "legendFormat": "Entries {{instance}}"
          },
          {
            "expr": "vanta_volatile_cache_cap_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Capacity {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
      },
      {
        "title": "Jemalloc Breakdown",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes"
          }
        },
        "targets": [
          {
            "expr": "vanta_jemalloc_allocated_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Allocated {{instance}}"
          },
          {
            "expr": "vanta_jemalloc_active_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Active {{instance}}"
          },
          {
            "expr": "vanta_jemalloc_resident_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Resident {{instance}}"
          },
          {
            "expr": "vanta_jemalloc_retained_bytes{job=~\"vantadb.*\"}",
            "legendFormat": "Retained {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
      },
      {
        "title": "HNSW Node Count",
        "type": "gauge",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "vanta_hnsw_nodes_count{job=~\"vantadb.*\"}",
            "legendFormat": "Nodes {{instance}}"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 }
      }
    ]
  }
}
