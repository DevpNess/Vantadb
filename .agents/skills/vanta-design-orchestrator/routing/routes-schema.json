{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vanta Design Routes Schema",
  "type": "object",
  "required": ["version", "categories"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "total_routes": { "type": "integer" },
    "conflict_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict", "resolution"],
        "properties": {
          "conflict": { "type": "string" },
          "resolution": { "type": "string" }
        }
      }
    },
    "categories": {
      "type": "object",
      "patternProperties": {
        "^[a-z-]+$": {
          "type": "object",
          "required": ["description", "routes"],
          "properties": {
            "description": { "type": "string" },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["task", "pipeline", "priority"],
                "properties": {
                  "task": { "type": "string" },
                  "pipeline": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                  },
                  "priority": { "type": "string", "enum": ["ALTA", "MEDIA", "BAJA"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
