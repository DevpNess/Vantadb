from __future__ import annotations

from typing import Any

class VantaVector:
    def __len__(self) -> int: ...
    def __getitem__(self, idx: int) -> float: ...
    def __repr__(self) -> str: ...

class VantaSearchHit:
    namespace: str
    key: str
    payload: str
    metadata: dict
    vector: VantaVector | None
    score: float
    id: int
    created_at_ms: int
    updated_at_ms: int
    version: int
    node_id: int
    expires_at_ms: int | None
    def __repr__(self) -> str: ...

