{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-v4-flash-free",
  "small_model": "deepseek-v4-flash-free",
  "subagent_depth": 2,
  "plugin": [
    "C:\\Users\\Eros\\.agents\\ponytail\\.opencode\\plugins\\ponytail.mjs"
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "discord": {
      "type": "local",
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        "$t = (Get-Content '.env.tokens' | Where-Object {$_ -match '^DISCORD_BOT_TOKEN=\"(.+)\"$'} | ForEach-Object {$Matches[1]}); $env:DISCORD_TOKEN = $t; bunx @rayenking/discord-mcp"
      ],
      "enabled": false
    },
    "metasearchmcp": {
      "command": [
        "metasearchmcp-mcp"
      ],
      "enabled": true,
      "type": "local",
      "description": "Búsqueda multi-provider: web, GitHub, académico, código. DuckDuckGo gratis sin key."
    },
    "argus": {
      "command": [
        "argus",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "type": "local",
      "description": "14 providers, extracción 12-step, dead URL recovery, RRF fusion."
    },
    "campaign": {
      "command": [
        "bun",
        ".opencode/task-system/mcp/campaign-server.mjs"
      ],
      "enabled": true,
      "type": "local",
      "description": "Plan de campaña: get_next_task, update_task_state, verify_cmd."
    },
    "vantadb": {
      "command": [
        "vanta-cli",
        "server",
        "--mcp",
        "--db",
        "C:/Users/Eros/.vantadb"
      ],
      "enabled": true,
      "type": "local",
      "description": "VantaDB MCP — memoria persistente y vector retrieval (15 tools: memory_put/get, query_iql, search_semantic, rehydrate...)."
    },
    "lottiefiles-creator": {
      "command": [
        "bunx",
        "@lottiefiles/creator-mcp@latest"
      ],
      "enabled": false,
      "type": "local",
      "description": "LottieFiles Creator MCP — crear y editar animaciones Lottie via IA."
    }
  }
}
